{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Posthook",
  "theme": "mint",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://posthook.io"
  },
  "favicon": "/favicon.svg",
  "metadata": {
    "og:site_name": "Posthook Docs",
    "og:image": "https://posthook.io/images/og-image.png",
    "og:description": "Posthook documentation — schedule webhooks for exactly when you need them. Guides, API reference, and integration patterns.",
    "twitter:card": "summary_large_image",
    "twitter:site": "@posthook"
  },
  "colors": {
    "primary": "#357EDD",
    "light": "#357EDD",
    "dark": "#357EDD"
  },
  "navbar": {
    "links": [
      {
        "label": "Community",
        "href": "https://github.com/posthook/community"
      },
      {
        "label": "Support",
        "href": "mailto:support@posthook.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://posthook.io/app/home"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart",
              "essentials/how-it-works"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "essentials/authentication",
              "essentials/scheduling",
              "essentials/receiving-webhooks",
              "essentials/security"
            ]
          },
          {
            "group": "Features",
            "pages": [
              "essentials/sequences",
              "essentials/async-hooks",
              "essentials/project-settings",
              "essentials/teams",
              "essentials/local-development",
              "essentials/config-as-code"
            ]
          },
          {
            "group": "Patterns",
            "pages": [
              "patterns/user-engagement",
              "patterns/auto-expiry",
              "patterns/polling",
              "patterns/debouncing",
              "patterns/dead-letter-queue",
              "patterns/auditing",
              "patterns/recurring-tasks"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/cli",
              "reference/errors",
              "reference/troubleshooting"
            ]
          },
          {
            "group": "Updates",
            "pages": [
              "changelog"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "code",
        "groups": [
          {
            "group": "Endpoints",
            "pages": [
              "api-reference/introduction",
              "api-reference/endpoint/create-hook",
              "api-reference/endpoint/get-hook",
              "api-reference/endpoint/list-hooks",
              "api-reference/endpoint/delete-hook",
              "api-reference/endpoint/bulk-retry",
              "api-reference/endpoint/bulk-replay",
              "api-reference/endpoint/bulk-cancel"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/essentials/hook-delivery",
      "destination": "/essentials/receiving-webhooks"
    },
    {
      "source": "/essentials/cli",
      "destination": "/reference/cli"
    }
  ],
  "api": {
    "openapi": "openapi.json"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/posthook",
      "github": "https://github.com/posthook"
    }
  }
}
